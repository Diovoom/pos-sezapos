240],[7255,7256],[7285,7286],[7302,7303],[7304,7307],[7340,7341],[7402,7403],[7450,7451],[7466,7467],[7540,7541],[7614,7615],[7630,7631],[7644,7645],[7646,7647],[7700,7701],[7737,7738],[7785,7786],[7803,7804],[7827,7828],[7853,7854],[7887,7888],[7914,7915],[7978,7979],[8000,8001],[8014,8015],[8030,8031],[8067,8068],[8121,8122],[8139,8140],[8166,8167],[8195,8196],[8240,8241],[8270,8271],[8337,8338],[8359,8360],[8386,8387],[8400,8401],[8416,8417],[8488,8489],[8509,8510],[8566,8567],[8583,8584],[8599,8600],[8656,8657],[8673,8674],[8687,8688],[8706,8707],[8721,8722],[8723,8724],[8753,8754],[8765,8766],[8771,8772],[8774,8775],[8776,8777],[8809,8810],[8853,8854],[8896,8897],[8940,8941],[8942,8943],[8977,8978],[9002,9003],[9022,9023],[9024,9025],[9035,9036],[9111,9112],[9165,9166],[9176,9177],[9207,9208],[9288,9289],[9311,9312],[9332,9333],[9355,9356],[9375,9466],"error instanceof Error ? error.message : \"Could not send reset email\");",[9482,9483],[9505,9506],[9512,9513],[9518,9519],[9520,9521],[9532,9533],[9540,9541],[9555,9556],[9578,9579],[9617,9618],[9700,9701],[9709,9710],[9735,9736],[9752,9753],[9754,9755],[9805,9806],[9830,9831],[9856,9857],[9917,9918],[9950,9951],[10020,10021],[10054,10055],[10081,10082],[10125,10126],[10187,10188],[10207,10208],[10239,10240],[10267,10268],[10303,10304],[10332,10333],[10398,10399],[10445,10446],[10461,10462],[10479,10480],[10505,10506],[10574,10575],[10596,10597],[10619,10620],[10687,10688],[10761,10762],[10813,10814],[10844,10845],[10867,10868],[10894,10895],[10920,10921],[10937,10938],[10946,10947],[10952,10953],[10955,10956],[348,475],"\n        name: \"description\",\n        content:\n          \"Product updates, release notes, and articles for independent retailers from the SEZA POS team.\",\n     ",[546,641],"\n        property: \"og:description\",\n        content: \"Product updates and articles for independent retailers.\",\n     ",[1143,1179],"\n          Product updates and retail insights.\n        ",[1341,1341],[1500,1542],"\n            <Link to=\"/signup\">Start free trial</Link>\n          ",[1596,1645],"\n            <Link to=\"/contact\">Get notified at launch</Link>\n          ",[405,549],"\n        name: \"description\",\n        content:\n          \"Join the team building modern point-of-sale software for independent retailers. Open roles and how to reach us.\",\n     ",[624,732],"\n        property: \"og:description\",\n        content: \"Help us build POS software that independent retailers actually love.\",\n     ",[1243,1286],"\n          Build the tools independent retail runs on.\n        ",[1449,1530],"\n          hiring round — but we're always interested in hearing from thoughtful engineers,\n         ",[1679,1794],"{\" \"}\n          <a className=\"text-primary underline\" href={`mailto:${LEGAL_CONFIG.supportEmail}`}>\n            {LEGAL_CONFIG.supportEmail}\n          </a>{\" \"}\n         ",[1965,2006],"\n            <Link to=\"/about\">Learn about SEZA</Link>\n          ",[820,989],"\n        name: \"description\",\n        content:\n          \"Talk to the SEZA POS team about pricing, hardware, migrations, or a demo. Send a message about pricing, hardware, migrations, or a demo.\",\n     ",[1063,1192],"\n        property: \"og:description\",\n        content:\n          \"Talk to the SEZA POS team. Send a message about pricing, hardware, migrations, or a demo.\",\n     ",[1933,2005],"\n        `Contact from ${form.name}${form.business ? ` (${form.business})` : \"\"}`,\n      ",[2151,2151],[2775,2775],[3126,3252],"\n                href={`tel:${LEGAL_CONFIG.phone}`}\n                className=\"text-sm font-semibold text-primary hover:underline\"\n              >\n                {LEGAL_CONFIG.phoneDisplay}\n              ",[3641,3660],"\n                support@sezapos.com\n              ",[3920,3976],"\n                Mon–Fri, 9am–6pm EST · We reply within one business day.\n              ",[4753,4829],"\n                Messages are reviewed as soon as practical during normal support operations.\n              ",[5409,5409],"\n                    ",[5740,5858],"\n                        id=\"name\"\n                        value={form.name}\n                        onChange={(e) => setForm({ ...form, name: e.target.value })}\n                        required\n                        autoComplete=\"name\"\n                     ",[6024,6159],"\n                        id=\"email\"\n                        type=\"email\"\n                        value={form.email}\n                        onChange={(e) => setForm({ ...form, email: e.target.value })}\n                        required\n                        autoComplete=\"email\"\n                     ",[6366,6495],"\n                      id=\"business\"\n                      value={form.business}\n                      onChange={(e) => setForm({ ...form, business: e.target.value })}\n                      autoComplete=\"organization\"\n                   ",[6669,6785],"\n                      id=\"message\"\n                      rows={5}\n                      value={form.message}\n                      onChange={(e) => setForm({ ...form, message: e.target.value })}\n                      required\n                   ",[29,52],[85,109],"\"@tanstack/react-router\";",[197,202],"\"***\";",[245,249],"\"@\");",[286,291],[331,331],[521,521],[594,594],[687,735],"\"Server configuration error\" }, { status: 500 });",[830,830],[874,882],"\"token\");",[946,985],"\"Token is required\" }, { status: 400 });",[1067,1067],[1187,1213],"\"email_unsubscribe_tokens\"",[1233,1236],"\"*\"",[1252,1259],"\"token\"",[1292,1292],[1377,1423],"\"Invalid or expired token\" }, { status: 404 });",[1525,1550],"\"already_unsubscribed\" });",[1607,1607],[1716,1716],[1789,1789],[1882,1930],[2065,2065],[2122,2130],[2422,2443],"\"content-type\") ?? \"\";",[2477,2512],"\"application/x-www-form-urlencoded\"",[2564,2564],[2619,2619],[2779,2797],"\"List-Unsubscribe\"",[2843,2851],[2912,2912],[3074,3074],[3137,3137],[3316,3355],[3437,3437],[3557,3583],[3603,3606],[3622,3629],[3662,3662],[3747,3793],[3897,3922],[4075,4101],[4174,4181],[4204,4213],"\"used_at\"",[4265,4265],[4318,4380],"\"Failed to mark token as used\", { error: updateError, token });",[4421,4472],"\"Failed to process unsubscribe\" }, { status: 500 });",[4565,4590],[4744,4763],"\"suppressed_emails\"",[4846,4859],"\"unsubscribe\"",[4889,4896],"\"email\"",[4911,4911],[4966,4992],"\"Failed to suppress email\"",[5102,5102],[5143,5194],[5226,5246],"\"Email unsubscribed\"",[5318,5318],[5367,5367],[5391,5391],[144,206],"\n  Accordion,\n  AccordionContent,\n  AccordionItem,\n  AccordionTrigger,\n",[410,546],"\n        name: \"description\",\n        content:\n          \"Frequently asked questions about SEZA POS — pricing, hardware, security, data, onboarding, and support.\",\n     ",[639,740],"\n        property: \"og:description\",\n        content: \"Answers about pricing, hardware, security, data, and support.\",\n     ",[911,1162],"\n        q: \"How long does setup take?\",\n        a: \"Setup time depends on the catalog, hardware, receipt configuration, employees, and payment setup. A basic test store can be created quickly, while a production rollout should include hardware and workflow testing.\",\n     ",[1173,1401],"\n        q: \"Do I need to install anything?\",\n        a: \"The merchant website runs in a modern browser. The dedicated Android register is installed as an app so it can use supported native scanning, device, printing, and offline capabilities.\",\n     ",[1412,1599],"\n        q: \"Can I import my existing products?\",\n        a: \"SEZA includes product-entry and bulk-import workflows. The exact source format may need cleanup or mapping before it can be imported safely.\",\n     ",[1610,1785],"\n        q: \"How many employees can I add?\",\n        a: \"Every plan includes multiple employee logins with role-based permissions. See the pricing page for the exact seat allotment per plan.\",\n     ",[1857,2003],"\n        q: \"Is there a free trial?\",\n        a: \"Yes. Every plan includes a 14-day free trial. No credit card is required to start, and you can cancel any time.\",\n     ",[2014,2124],"\n        q: \"Can I change plans later?\",\n        a: \"Yes. Upgrade or downgrade from Settings > Billing. Changes are prorated.\",\n     ",[2135,2290],"\n        q: \"How do I cancel?\",\n        a: \"Cancel any time from Settings > Billing. You keep access through the end of your billing period. There is no cancellation fee.\",\n     ",[2301,2483],"\n        q: \"Do you charge per terminal?\",\n        a: \"SEZA is priced by plan. Device, employee, store, and feature limits are determined by the current plan details shown during signup or billing.\",\n     ",[2546,2760],"\n        q: \"What hardware do I need?\",\n        a: \"At minimum: a tablet, laptop, or PC with a modern browser. Most stores also add a barcode scanner, receipt printer, and cash drawer. See the Hardware page for compatible models.\",\n     ",[2771,3016],"\n        q: \"Can I use my current scanner and printer?\",\n        a: \"Many standard USB or Bluetooth HID scanners can work, and SEZA includes ESC/POS-oriented receipt workflows. Printer compatibility still depends on model, connection, device, and driver setup.\",\n     ",[3027,3319],"\n        q: \"Do you support card terminals?\",\n        a: \"SEZA contains Stripe Terminal-ready architecture, but in-person card use requires an approved merchant account, supported reader, live configuration, and an Android build with the required native plugin. See the Integrations page for current status.\",\n     ",[3389,3675],"\n        q: \"Where is my data stored?\",\n        a: \"In the configured managed cloud environment, with protected connections and merchant/store authorization controls. Backup and recovery capabilities depend on the deployed providers and configuration. See the Security page for current public details.\",\n     ",[3686,3967],"\n        q: \"Do you store card numbers?\",\n        a: \"SEZA does not store full subscription card numbers on its own servers. Subscription billing is handled through Stripe-hosted payment experiences, while customer card acceptance depends on the connected payment provider and supported hardware.\",\n     ",[3978,4183],"\n        q: \"Can I export my data?\",\n        a: \"Export tools are available for supported reports and directories. Availability varies by record type, and additional export coverage may be added as the platform develops.\",\n     ",[4194,4467],"\n        q: \"What happens if I cancel?\",\n        a: \"Paid access generally continues through the end of the current billing period unless the account is suspended for another reason. Data is then handled under the Terms and Privacy Policy, including applicable legal and backup retention.\",\n     ",[4529,4794],"\n        q: \"How do I get help?\",\n        a: \"Visit the Support page, email support@sezapos.com, or open a case from inside the merchant experience when available. Response timing depends on issue severity, available support coverage, and the applicable plan or written agreement.\",\n     ",[4805,5020],"\n        q: \"Do you offer onboarding?\",\n        a: \"SEZA provides onboarding steps inside the product. Any guided setup or implementation assistance is offered only when it is included in the selected plan or confirmed in writing.\",\n     ",[5325,5351],"\n          Frequently asked questions\n        ",[5415,5471],"\n          Everything owners typically ask before starting a trial.\n        ",[6548,6585],"\n            <Link to=\"/contact\">Contact us</Link>\n          ",[6639,6679],"\n            <Link to=\"/support\">Visit Support</Link>\n          ",[87,130],"\n  Package,\n  Users,\n  BarChart3,\n  Clock,\n  Receipt,\n ",[150,206],"\n  Shield,\n  CreditCard,\n  Printer,\n  Wifi,\n  MessageSquare,\n  Mail,\n ",[488,669],"\n        name: \"description\",\n        content:\n          \"Fast checkout, inventory tracking, employee time clock, refunds, SMS and email receipts, reports, and more — everything a modern retail store needs.\",\n     ",[744,841],"\n        property: \"og:description\",\n        content: \"Everything a modern retail store needs, in one cloud POS.\",\n     ",[1100,1183],"\n  title: string;\n  blurb: string;\n  items: { icon: any; title: string; body: string }[];\n",{"messageId":"40605","fix":"41312","desc":"40607"},{"messageId":"40608","fix":"41313","desc":"40610"},[1345,1490],"\n        icon: ScanBarcode,\n        title: \"Barcode & keypad checkout\",\n        body: \"Scan or type — supports USB and Bluetooth scanners, custom items, and quick keys.\",\n     ",[1501,1644],"\n        icon: CreditCard,\n        title: \"Card & cash payments\",\n        body: \"Payment terminal integration, cash tendering, split payments, and change calculation.\",\n     ",[1655,1788],"\n        icon: RotateCcw,\n        title: \"Refunds & exchanges\",\n        body: \"Full or partial refunds with restocking, void support, and manager overrides.\",\n     ",[1799,1925],"\n        icon: Mail,\n        title: \"Email & SMS receipts\",\n        body: \"Send digital receipts by email or text message, or print thermal receipts.\",\n     ",[2080,2194],"\n        icon: Package,\n        title: \"Product catalog\",\n        body: \"SKUs, variants, categories, cost & price, tax rules, and images.\",\n     ",[2205,2327],"\n        icon: Boxes,\n        title: \"Stock tracking\",\n        body: \"Automatic stock decrement on sale, restock on refund, and low-stock alerts.\",\n     ",[2338,2459],"\n        icon: Wallet,\n        title: \"Register sessions\",\n        body: \"Open/close registers with cash counts and end-of-shift reconciliation.\",\n     ",[2604,2720],"\n        icon: Users,\n        title: \"Roles & permissions\",\n        body: \"Owner, manager, and cashier roles with fine-grained permissions.\",\n     ",[2731,2848],"\n        icon: Clock,\n        title: \"Time clock & payroll\",\n        body: \"Clock in/out with PIN, late tracking, and payroll-ready reports.\",\n     ",[2859,2977],"\n        icon: Shield,\n        title: \"Manager overrides\",\n        body: \"Require manager approval for refunds, discounts, and price changes.\",\n     ",[3137,3261],"\n        icon: BarChart3,\n        title: \"Sales & shift reports\",\n        body: \"Daily, weekly, and per-shift sales, taxes, tenders, and top items.\",\n     ",[3272,3386],"\n        icon: Receipt,\n        title: \"Audit logs\",\n        body: \"Every sensitive action is recorded with actor, target, and timestamp.\",\n     ",[3397,3506],"\n        icon: Wifi,\n        title: \"Cloud sync\",\n        body: \"Your data lives in the cloud — access it from any device, anywhere.\",\n     ",[3517,3636],"\n        icon: Printer,\n        title: \"Hardware support\",\n        body: \"Receipt printers, cash drawers, barcode scanners, customer displays.\",\n     ",[3647,3769],"\n        icon: MessageSquare,\n        title: \"Customer profiles\",\n        body: \"Track repeat customers, purchase history, and marketing consent.\",\n     ",[3974,4015],"\n          Everything you need to run a modern store\n        ",[4197,4197],[4315,4357],[4411,4450],"\n            <Link to=\"/pricing\">View pricing</Link>\n          ",[884,884],[1461,1564],"\n      \"Touch-friendly checkout\",\n      \"Android cash-only offline workflow\",\n      \"Cloud synchronization when connected\",\n    ",[2065,2158],"\n      \"ESC/POS-oriented receipts\",\n      \"USB, network, or Bluetooth setup\",\n      \"Test before production use\",\n    ",[2769,2866],"\n      \"Provider approval required\",\n      \"Reader compatibility varies\",\n      \"Card payments require connectivity\",\n    ",[3971,4040],"\n            <MonitorSmartphone className=\"size-4\" /> SEZA hardware planning guide\n          ",[4403,4403],[4575,4663],"\n              asChild\n              size=\"lg\"\n              className=\"rounded-full bg-white px-7 text-blue-700 hover:bg-blue-50\"\n            ",[4707,4764],"\n                <MonitorSmartphone className=\"size-4\" /> Explore hardware\n              ",[4810,4953],"\n              asChild\n              size=\"lg\"\n              variant=\"outline\"\n              className=\"rounded-full border-white/25 bg-transparent px-7 text-white hover:bg-white/10 hover:text-white\"\n            ",[5045,5061],"\n                Start free trial\n              ",[5352,5352],[5672,5707],"\n            The pieces of a complete SEZA setup\n          ",[5866,5866],[6093,6259],"\n              key={item.title}\n              className=\"rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_18px_45px_-35px_rgba(15,23,42,0.5)] dark:border-white/10 dark:bg-slate-900/60\"\n            ",[6364,6396],"\n                <item.icon className=\"size-6\" />\n              ",[7372,7459],"\n            manufacturer, model number, operating system, and connection type so compatibility can\n           ",[7562,7610],"\n            <Link to=\"/contact\">Send hardware details</Link>\n          ",[5522,5646],"\n    icon: Store,\n    title: \"Convenience stores\",\n    body: \"Fast barcode checkout, age checks, cash control and shift accountability.\",\n ",[5653,5784],"\n    icon: ShoppingBag,\n    title: \"Liquor & bottle shops\",\n    body: \"Inventory visibility and manager-controlled age-verification workflows.\",\n ",[5791,5913],"\n    icon: Box,\n    title: \"Mini marts & grocery\",\n    body: \"Large catalogs, category taxes, quick keys and everyday stock movement.\",\n ",[5920,6052],"\n    icon: Sparkles,\n    title: \"Beauty & specialty retail\",\n    body: \"Variants, product images, employee access and customer receipt options.\",\n ",[6059,6187],"\n    icon: Building2,\n    title: \"Apparel & sneaker stores\",\n    body: \"Organized items, sizes, staff controls and clear product reporting.\",\n ",[6194,6330],"\n    icon: ReceiptText,\n    title: \"Counter-service businesses\",\n    body: \"Simple order entry, cash and card workflows, receipts and daily totals.\",\n ",[6360,6492],"\n    icon: MonitorSmartphone,\n    title: \"Countertop register\",\n    body: \"A touch-friendly main screen for the cashier and day-to-day selling.\",\n ",[6499,6638],"\n    icon: TabletSmartphone,\n    title: \"Tablet or Android device\",\n    body: \"A flexible register for smaller counters, mobile service or backup use.\",\n ",[6645,6765],"\n    icon: Printer,\n    title: \"Thermal receipt printer\",\n    body: \"Compatible ESC/POS printing for clean, fast customer receipts.\",\n ",[6772,6883],"\n    icon: Barcode,\n    title: \"Barcode scanner\",\n    body: \"USB, Bluetooth HID or the device camera for fast item lookup.\",\n ",[6890,7007],"\n    icon: Banknote,\n    title: \"Cash drawer\",\n    body: \"Open automatically through compatible printer or hardware connections.\",\n ",[7014,7156],"\n    icon: CreditCard,\n    title: \"Payment terminal\",\n    body: \"Stripe Terminal-ready workflows for compatible readers after merchant and Android setup.\",\n ",[7163,7277],"\n    icon: Laptop,\n    title: \"Owner computer\",\n    body: \"Use the web dashboard on a modern laptop or desktop from anywhere.\",\n ",[7284,7406],"\n    icon: Smartphone,\n    title: \"Customer display\",\n    body: \"Show the store brand and sale details on a second compatible screen.\",\n ",[9207,9385],"\n        className=\"seza-marquee border-b border-blue-100/80 bg-blue-50/70 text-blue-950 dark:border-blue-400/10 dark:bg-blue-500/5 dark:text-blue-100\"\n        aria-label=\"SEZA product promises\"\n      ",[11591,11591],[11805,11932],"\n                  asChild\n                  size=\"lg\"\n                  className=\"h-13 w-full rounded-full px-7 text-base shadow-[0_18px_45px_-18px_rgba(37,99,235,0.9)] sm:w-auto\"\n                ",[12172,12350],"\n                  asChild\n                  size=\"lg\"\n                  variant=\"outline\"\n                  className=\"h-13 w-full rounded-full border-slate-300 bg-white/75 px-7 text-base backdrop-blur sm:w-auto dark:border-white/15 dark:bg-white/5\"\n                ",[12681,12746],"\n                  <Check className=\"size-3.5 text-emerald-600\" /> 14-day free trial\n                ",[12821,12892],"\n                  <Check className=\"size-3.5 text-emerald-600\" /> No credit card required\n                ",[12967,13029],"\n                  <Check className=\"size-3.5 text-emerald-600\" /> Cancel anytime\n                ",[14230,14355],"\n                src={homeSell.url}\n                alt=\"SEZA POS register showing the checkout workspace\"\n                className=\"block w-full rounded-b-[22px] bg-white\"\n             ",[14748,14778],"\n                  <WifiOff className=\"size-5\" />\n                ",[14807,14942],"\n                  <div className=\"text-sm font-bold\">Offline cash mode</div>\n                  <div className=\"text-xs text-muted-foreground\">Keep the register moving</div>\n                ",[15383,15414],"\n                  <KeyRound className=\"size-5\" />\n                ",[15443,15580],"\n                  <div className=\"text-sm font-bold\">Manager protected</div>\n                  <div className=\"text-xs text-muted-foreground\">Approvals stay accountable</div>\n                ",[17892,17911],"\n                  Compatibility first\n                ",[18040,18088],"\n                Plan the complete setup built for your business.\n              ",[18182,18323],"\n                Review register, scanner, receipt-printer, cash-drawer, customer-display, and\n                payment-reader requirements before you spend money on hardware.\n              ",[19056,19086],"\n              One connected operating system\n            ",[19189,19261],"\n              Everything the register needs. Everything the owner needs after closing.\n            ",[19339,19431],"\n              SEZA keeps checkout simple while the controls, records and reports stay organized\n              behind it.\n            ",[20402,20417],"\n                        {group.eyebrow}\n                      ",[20809,20908],"\n                        key={item}\n                        className=\"flex items-start gap-2 text-sm leading-5 text-slate-700 dark:text-slate-300\"\n                      ",[21487,21505],"\n              Real product views\n            ",[21608,21648],"\n              From the first scan to the final report.\n            ",[21726,21838],"\n              Cashiers get a focused selling screen. Owners get the inventory and reporting detail\n              needed to run the business.\n            ",[21988,22069],"\n                src={homeInventory.url}\n                alt=\"SEZA inventory management screen\"\n                label=\"Inventory\"\n             ",[22237,22268],"\n                Inventory that follows the sale\n              ",[22354,22379],"\n                Stop guessing what moved.\n              ",[22461,22629],"\n                Products, stock changes, suppliers and item performance live in the same system as\n                checkout, so the owner can trace what happened instead of rebuilding the story\n                later.\n              ",[22723,22799],"\n                  icon={Barcode}\n                  title=\"Scan to find\"\n                  body=\"Search or scan products quickly.\"\n               ",[22829,22906],"\n                  icon={Package}\n                  title=\"Track movement\"\n                  body=\"Sales and returns update stock.\"\n               ",[22936,23019],"\n                  icon={CircleDollarSign}\n                  title=\"Watch margins\"\n                  body=\"Keep price and cost together.\"\n               ",[23049,23130],"\n                  icon={Cloud}\n                  title=\"See it remotely\"\n                  body=\"Review inventory from the dashboard.\"\n               ",[23420,23451],"\n                Reports people can actually use\n              ",[23537,23583],"\n                Know how the day ended before tomorrow starts.\n              ",[23665,23789],"\n                Review sales, tenders, taxes, employees, products and register activity without\n                exporting the basics to a spreadsheet first.\n              ",[24368,24396],"\n                      <Check className=\"size-4\" />\n                    ",[25103,25129],"\n                Designed for real counters\n              ",[25234,25293],"\n                Start with the hardware you have. Build the setup you want.\n              ",[25418,25570],"\n                Use the SEZA compatibility guide to plan a complete setup for the way your business\n                actually operates, then confirm exact model support before purchase.\n              ",[25656,25747],"\n                  asChild\n                  size=\"lg\"\n                  className=\"rounded-full bg-white px-6 text-slate-950 hover:bg-slate-100\"\n                ",[25788,25849],"\n                    View hardware compatibility <ArrowRight className=\"size-4\" />\n                  ",[26006,26033],"\n                  Exact model review required\n                ",[26583,26615],"\n                    <item.icon className=\"size-5\" />\n                  ",[27128,27161],"\n              Built around independent business\n            ",[27264,27308],"\n              Flexible enough for the store you run today.\n            ",[27550,27782],"\n                  to=\"/industries\"\n                  className=\"group flex h-full items-start gap-4 rounded-3xl border border-slate-200 bg-white p-6 transition-all hover:-translate-y-1 hover:border-primary/35 hover:shadow-xl dark:border-white/10 dark:bg-slate-900/60\"\n                ",[27900,27936],"\n                    <industry.icon className=\"size-6\" />\n                  ",[28069,28214],"\n                      {industry.title}\n                      <ChevronRight className=\"size-4 text-muted-foreground transition-transform group-hover:translate-x-1 group-hover:text-primary\" />\n                    ",[28311,28326],"\n                      {industry.body}\n                    ",[28792,28817],"\n              Simple, transparent plans\n            ",[28920,28970],"\n              Start small. Move up when the business needs more.\n            ",[29048,29132],"\n              Every plan begins with a 14-day free trial. No credit card is required to test SEZA.\n            ",[29266,29398],"\n                name: \"Starter\",\n                price: \"$29\",\n                note: \"For owner-operated stores\",\n                points: [\"Core POS checkout\", \"Inventory tools\", \"Basic reports\"],\n             ",[29417,29579],"\n                name: \"Pro\",\n                price: \"$59\",\n                note: \"For growing teams\",\n                points: [\n                  \"Everything in Starter\",\n                  \"More employee tools\",\n                  \"SMS receipts & advanced reports\",\n                ],\n                featured: true,\n             ",[29598,29740],"\n                name: \"Business\",\n                price: \"$89\",\n                note: \"For advanced operations\",\n                points: [\"Everything in Pro\", \"Expanded controls\", \"High-volume operations\"],\n             ",[29792,30042],"\n                key={plan.name}\n                className={`relative rounded-[28px] border p-7 ${plan.featured ? \"border-primary bg-white shadow-[0_30px_80px_-35px_rgba(37,99,235,0.5)] dark:bg-slate-900\" : \"border-slate-200 bg-white/75 dark:border-white/10 dark:bg-slate-900/50\"}`}\n              ",[30078,30247],"(\n                  <div className=\"absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-white\">\n                    Most popular\n                  </div>\n                )",[30390,30528],"\n                  <span className=\"text-4xl font-black tracking-tight\">{plan.price}</span>\n                  <span className=\"pb-1 text-sm text-muted-foreground\">/month</span>\n                ",[30711,30828],"(\n                    <li key={point} className=\"flex items-center gap-2 text-sm\">\n                      <Check className=\"size-4 text-emerald-600\" />\n                      {point}\n                    </li>\n                  )",[30951,31120],"\n            <Button asChild variant=\"outline\" size=\"lg\" className=\"rounded-full bg-white/80\">\n              <Link to=\"/pricing\">\n                Compare every plan <ArrowRight className=\"size-4\" />\n              </Link>\n            </Button>\n          ",[31397,31423],"\n              Questions before you begin\n            ",[31526,31558],"\n              Straight answers. No sales maze.\n            ",[31636,31765],"\n              Learn how the trial, hardware, offline mode, manager approvals and Stripe billing work\n              before putting SEZA in front of a cashier.\n            ",[31899,31935],"\n                <Link to=\"/faq\">View all FAQs</Link>\n              ",[32016,32089],"\n                <Link to=\"/contact\">\n                  Contact SEZA <ArrowRight className=\"size-4\" />\n                </Link>\n              ",[32191,32342],"\n              type=\"single\"\n              collapsible\n              className=\"rounded-[28px] border border-slate-200 bg-white px-5 shadow-sm dark:border-white/10 dark:bg-slate-900/60 sm:px-7\"\n            ",[32416,32504],"\n                  value={`faq-${index}`}\n                  key={faq.q}\n                  className=\"border-slate-200/80 dark:border-white/10\"\n                ",[32608,32615],"\n                    {faq.q}\n                  ",[32728,32735],"\n                    {faq.a}\n                  ",[33431,33459],"\n              <Store className=\"size-7\" />\n            ",[33564,33607],"\n              Give your store a smarter operating system.\n            ",[33694,33825],"\n              Create the business, add a few products and run a real test sale. You will know\n              quickly whether SEZA fits the way your store works.\n            ",[33933,34026],"\n                asChild\n                size=\"lg\"\n                className=\"h-13 rounded-full bg-white px-7 text-blue-700 hover:bg-blue-50\"\n              ",[34120,34177],"\n                  Start 14-day free trial <ArrowRight className=\"size-4\" />\n                ",[34227,34375],"\n                asChild\n                size=\"lg\"\n                variant=\"outline\"\n                className=\"h-13 rounded-full border-white/35 bg-transparent px-7 text-white hover:bg-white/10 hover:text-white\"\n              ",[34413,34459],"\n                  <Headphones className=\"size-4\" /> Talk to SEZA\n                ",[34564,34665],"\n              No credit card required. Subscription billing is securely processed by Stripe when you\n              choose a plan.\n            ",[35322,35482],"\n            <span className=\"size-2 rounded-full bg-rose-400\" />\n            <span className=\"size-2 rounded-full bg-amber-300\" />\n            <span className=\"size-2 rounded-full bg-emerald-400\" />\n          ",[35637,35781],"\n          src={src}\n          alt={alt}\n          loading=\"lazy\"\n          className=\"block w-full rounded-[20px] bg-white transition-transform duration-700 group-hover:scale-[1.015]\"\n       ",[35837,35921],"\n  icon: Icon,\n  title,\n  body,\n}: {\n  icon: typeof Fingerprint;\n  title: string;\n  body: string;\n",[415,599],"\n        name: \"description\",\n        content:\n          \"SEZA POS is built for convenience stores, liquor stores, mini marts, specialty retail, cafés, and smoke shops. See how the platform fits your industry.\",\n     ",[676,799],"\n        property: \"og:description\",\n        content:\n          \"Purpose-built POS for convenience, liquor, mini marts, cafés, and specialty retail.\",\n     ",[998,1151],"\n      \"Barcode scanning with per-scan promotions\",\n      \"Age-verified sales workflows\",\n      \"Quick keys for high-turnover items\",\n      \"Shift close with cash drop reporting\",\n    ",[1300,1458],"\n      \"ID scan and age-gating at the register\",\n      \"Case + bottle unit tracking\",\n      \"Supplier and purchase-order management\",\n      \"Variance reporting for cash and inventory\",\n    ",[1614,1747],"\n      \"Weighted items and per-unit pricing\",\n      \"Tax rules per category\",\n      \"Vendor receiving and stock counts\",\n      \"Customer accounts and loyalty\",\n    ",[1889,2017],"\n      \"Modifier groups and combos\",\n      \"Custom quick-add tiles\",\n      \"Tip prompts and split payments\",\n      \"Kitchen ticket integration (roadmap)\",\n    ",[2161,2296],"\n      \"Variant matrices (size, color, style)\",\n      \"Purchase orders and receiving\",\n      \"Discount rules per SKU or cart\",\n      \"Customer purchase history\",\n    ",[2441,2591],"\n      \"ID scan and age-gating\",\n      \"Product-level compliance flags\",\n      \"Detailed audit trail on sales and refunds\",\n      \"Employee permissions for restricted actions\",\n    ",[2812,2831],"\n          Industries we serve\n        ",[2911,2963],"\n          Built for the way independent retail actually works.\n        ",[3128,3214],"\n          is the same modern cloud platform — the workflows are tuned for the way your industry\n         ",[4296,4362],"\n          SEZA's core is flexible — most retail formats work out of the box.\n        ",[4470,4512],[4576,4626],"\n            <Link to=\"/contact\">Ask about your industry</Link>\n          ",[798,911],"\n        property: \"og:description\",\n        content: \"A transparent view of available, setup-required, and roadmap connections.\",\n     ",[1263,1442],"\n        name: \"Stripe subscription billing\",\n        status: \"available\",\n        note: \"SEZA plan checkout, invoices, billing status, and saved subscription payment methods are handled through Stripe.\",\n     ",[1453,1713],"\n        name: \"Stripe Terminal\",\n        status: \"setup\",\n        note: \"The codebase includes Terminal-oriented endpoints and Android driver architecture. Production use requires provider approval, live keys, compatible readers, and the required native plugin in the Android build.\",\n     ",[1724,1917],"\n        name: \"Wallet and contactless acceptance\",\n        status: \"setup\",\n        note: \"Availability depends on the connected Stripe Terminal reader, country, merchant account, device, and provider configuration.\",\n     ",[1928,2063],"\n        name: \"Split tender\",\n        status: \"roadmap\",\n        note: \"A guided workflow for dividing one sale across multiple tender types remains planned.\",\n     ",[2162,2346],"\n        name: \"SMS receipts\",\n        status: \"setup\",\n        note: \"The receipt workflow is present and requires valid SMS-provider credentials, a sending number, and compliant merchant consent practices.\",\n     ",[2357,2517],"\n        name: \"Email receipts\",\n        status: \"setup\",\n        note: \"The receipt workflow is present and requires the deployed email service and sender configuration to be active.\",\n     ",[2528,2675],"\n        name: \"Printed receipts\",\n        status: \"setup\",\n        note: \"Receipt printing depends on a compatible printer, connection method, and device-specific setup.\",\n     ",[2768,2915],"\n        name: \"CSV exports\",\n        status: \"available\",\n        note: \"Export-supported reports and directories can be moved into spreadsheet and accounting workflows.\",\n     ",[2926,3037],"\n        name: \"QuickBooks Online\",\n        status: \"roadmap\",\n        note: \"Direct accounting synchronization has not been released.\",\n     ",[3048,3146],"\n        name: \"Xero\",\n        status: \"roadmap\",\n        note: \"Direct accounting synchronization has not been released.\",\n     ",[3231,3384],"\n        name: \"Shared inventory API\",\n        status: \"roadmap\",\n        note: \"A public merchant API for external catalog and inventory synchronization has not been released.\",\n     ",[3395,3510],"\n        name: \"Shopify connector\",\n        status: \"roadmap\",\n        note: \"A supported two-way Shopify connector has not been released.\",\n     ",[3591,3756],"\n        name: \"USB and Bluetooth HID scanners\",\n        status: \"available\",\n        note: \"Standard keyboard-style scanners can work where the operating system exposes them as HID input.\",\n     ",[3767,3902],"\n        name: \"Android camera scanning\",\n        status: \"available\",\n        note: \"Supported Android builds can use the device camera for barcode scanning.\",\n     ",[3913,4064],"\n        name: \"ESC/POS-oriented printing\",\n        status: \"setup\",\n        note: \"Actual support depends on the printer model, connection, driver, and device configuration.\",\n     ",[4075,4210],"\n        name: \"Printer-driven cash drawers\",\n        status: \"setup\",\n        note: \"Drawer opening depends on compatible printer ports and command settings.\",\n     ",[4289,4433],"\n        name: \"Merchant-facing public API\",\n        status: \"roadmap\",\n        note: \"A documented external API for merchant-built integrations has not been released.\",\n     ",[4444,4576],"\n        name: \"Outbound merchant webhooks\",\n        status: \"roadmap\",\n        note: \"Configurable outbound sale, refund, and stock events remain planned.\",\n     ",[4680,4790],"\n    label: \"Available\",\n    className: \"bg-emerald-100 text-emerald-800 dark:bg-emerald-400/10 dark:text-emerald-300\",\n ",[4804,4911],"\n    label: \"Setup required\",\n    className: \"bg-amber-100 text-amber-800 dark:bg-amber-400/10 dark:text-amber-300\",\n ",[4927,5023],"\n    label: \"Roadmap\",\n 